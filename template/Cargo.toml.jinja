[package]
name = "{{ project_name }}"
version = "{{ project_version }}"
edition = "2021"
license = "{{ copyright_license }}"
description = "{{ project_description }}"
keywords = ["{{ project_keywords.split(',') | map('trim') | join('", "') }}"]
repository = "https://github.com/{{ vcs_github_path }}"
homepage = "https://github.com/{{ vcs_github_path }}"
documentation = "https://github.com/{{ vcs_github_path }}/blob/main/README.md"
{% if copyright_license != 'Unlicense' %}
authors = ["{{ copyright_holder_name }} <{{ copyright_holder_email }}>"]
{% endif %}

[dependencies]

[dev-dependencies.cargo-husky]
version = "1"
default-features = false
features = ["user-hooks"]
